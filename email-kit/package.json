{
  "name": "inkpost-email-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Four responsive HTML emails for a fictional coffee roaster, built by a small Node script with no dependencies.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node checks/serve.mjs . 8934",
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "test": "node --test tests/lib.test.mjs tests/emails.test.mjs",
    "art": "node art/art.mjs",
    "check:render": "node checks/render.mjs",
    "check:preview": "node checks/preview.mjs",
    "cover": "node checks/cover.mjs"
  }
}
